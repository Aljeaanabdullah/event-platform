# انسخ هذا الملف إلى .env.local واملأ القيم. لا ترفع .env.local إلى GitHub أبدًا.

# ===== عام (يظهر في المتصفح) =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# من Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ===== سري (الخادم فقط) =====
# ⚠️ يتجاوز RLS بالكامل — لا تضعه في متغير يبدأ بـ NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_xxx

# ===== الدفع (الخادم فقط) =====
# MyFatoorah Sandbox: https://apitest.myfatoorah.com — المفتاح من بوابة MyFatoorah التجريبية
MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
# مزوّد وهمي للتطوير/المعاينة فقط (يُتجاهل في Production دائمًا)
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=generate-a-random-32-byte-hex-value

# ===== بيانات الاختبار (محلي/معاينة فقط — تُتجاهل في Production) =====
SHOW_TEST_DATA=1
# كلمة مرور حسابات اختبار E2E (supabase/seed/test-data.sql)
E2E_TEST_PASSWORD=
